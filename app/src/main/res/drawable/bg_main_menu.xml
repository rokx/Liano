<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#2F6EB8"
                android:startColor="#5A9BE6" />
        </shape>
    </item>

    <item
        android:bottom="36dp"
        android:left="-18dp"
        android:right="-18dp"
        android:top="36dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#22FFFFFF" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
