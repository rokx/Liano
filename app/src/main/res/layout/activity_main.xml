<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sheetSelectionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_menu"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.35"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/uploadMidiButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_song_button"
                    android:minHeight="44dp"
                    android:padding="8dp"
                    android:text="Upload MIDI"
                    android:textColor="@android:color/black"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/inputModeButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_song_button"
                    android:minHeight="44dp"
                    android:padding="8dp"
                    android:text="Input: Microphone"
                    android:textColor="@android:color/black"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/pianoTestButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_song_button"
                    android:minHeight="44dp"
                    android:padding="8dp"
                    android:text="Test USB piano"
                    android:textColor="@android:color/black"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/openMetronomeButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_song_button"
                    android:minHeight="44dp"
                    android:padding="8dp"
                    android:text="Metronome"
                    android:textColor="@android:color/black"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/app_logo"
                android:scaleType="centerInside"
                android:src="@drawable/ic_liano_launcher" />
        </LinearLayout>

        <TextView
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Songs"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="520dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/sheetButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EAF3FF"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backToMenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back" />

            <Button
                android:id="@+id/pausePlaybackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Pause" />

            <Button
                android:id="@+id/playInputModeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Input: Microphone" />
        </LinearLayout>

        <com.rokx.liano.NoteBandView
            android:id="@+id/noteBand"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/taskText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Play: C D  C D  C D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/metronomeSpeedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Metronome: 60 BPM"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/greatWorkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:text="Great work"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pitchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Waiting for input..."
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pianoTestContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backFromPianoTestButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back" />

            <Button
                android:id="@+id/testInputModeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Input: Microphone" />

            <TextView
                android:id="@+id/pianoTestStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="Waiting for input..."
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.rokx.liano.PianoKeyboardView
            android:id="@+id/pianoKeyboardView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:padding="12dp" />

        <TextView
            android:id="@+id/pressedNotesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pressed: none"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/metronomeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7FAFF"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backFromMetronomeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="Metronome settings"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/bpmValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:text="60 BPM"
            android:textSize="42sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/decreaseBpmButton"
                android:layout_width="76dp"
                android:layout_height="64dp"
                android:text="-"
                android:textSize="30sp" />

            <Button
                android:id="@+id/increaseBpmButton"
                android:layout_width="76dp"
                android:layout_height="64dp"
                android:layout_marginStart="18dp"
                android:text="+"
                android:textSize="30sp" />
        </LinearLayout>

        <Button
            android:id="@+id/metronomeStartStopButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="54dp"
            android:text="Start"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/keepMetronomeInBackgroundCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Keep metronome playing in background"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
